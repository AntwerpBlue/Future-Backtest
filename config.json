{
  "symbols": [
    {"code": "KQ.m@DCE.j",   "tick_size": 0.5,  "session_template": "night_2300"},
    {"code": "KQ.m@DCE.i",   "tick_size": 0.5,  "session_template": "night_2300"},
    {"code": "KQ.m@SHFE.au", "tick_size": 0.02, "session_template": "night_0230"},
    {"code": "KQ.m@SHFE.cu", "tick_size": 10.0, "session_template": "night_0100"},
    {"code": "KQ.m@SHFE.ag", "tick_size": 1.0,  "session_template": "night_0230"},
    {"code": "KQ.m@CZCE.SA", "tick_size": 0.5,  "session_template": "night_2300"},
    {"code": "KQ.m@CZCE.FG", "tick_size": 0.5,  "session_template": "night_2300"}
  ],

  "data_source": {
    "source_dir": "/program1/tqcta_data/kline/main",
    "start_date": "2021-01-01",
    "end_date": "2025-12-31"
  },

  "feature_engineering": {
    "label_bars": 6,
    "label_threshold": 0.5,
    "atr_long_window": 400
  },

  "data_split": {
    "train_start_year": 2019,
    "train_end_year": 2022,
    "valid_ratio": 0.3,
    "embargo": 10
  },

  "feature_selection": {
    "enabled": true,
    "drop_ratio": 0.20,
    "method": "shap",
    "add_dummy": true,
    "compute_shap": true,
    "shap_sample_size": 1000
  },

  "signal_filter": {
    "use_rolling_quantile": true,
    "rolling_window": [50, 100, 200],
    "signal_quantile": [0.80, 0.85, 0.88, 0.90, 0.92, 0.95, 0.98],
    "confidence_threshold": 0.42
  },

  "lgb_params": {
    "objective": "multiclass",
    "num_class": 3,
    "metric": ["multi_logloss", "multi_error"],
    "boosting_type": "gbdt",
    "num_leaves": 15,
    "max_depth": 4,
    "learning_rate": 0.005,
    "min_data_in_leaf": 5000,
    "lambda_l1": 2.0,
    "lambda_l2": 2.0,
    "feature_fraction": 0.8,
    "bagging_fraction": 0.8,
    "bagging_freq": 5,
    "class_weight": "balanced",
    "verbose": -1,
    "seed": 42,
    "num_threads": 8
  },

  "training": {
    "num_boost_round": 500
  },

  "output": {
    "output_dir": "./train_result",
    "temp_data_dir": "./temp_data"
  },

  "factor_analysis": {
    "factors": ["RSI_mid", "ATR_z", "ret_1h", "oi_change", "vwap_deviation", "pos_1d"],
    "ic_forward_periods": [1, 2, 6, 12],
    "use_ror_norm": true,
    "correlation_method": "spearman",
    "correlation_threshold": 0.7,
    "quantile_analysis": {
      "n_quantiles": 5,
      "rolling_window": 500,
      "min_samples": 20
    },
    "backtest": {
      "enabled": true,
      "slippage_ticks": 1.5,
      "rolling_window": 500,
      "min_samples": 20,
      "thresholds": [[0.2, 0.8], [0.25, 0.75], [0.3, 0.7]]
    },
    "output_dir": "./factor_result"
  }
}
